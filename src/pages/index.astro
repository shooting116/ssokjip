---
import Base from '../layouts/Base.astro';
import { loadSummary } from '../lib/data/index.ts';
import { pct } from '../lib/ui/format.ts';
import { roneSido, roneText } from '../lib/data/rone.ts';
import { LINES } from '../lib/data/lines.ts';
import { getCollection } from 'astro:content';
import { CAT_SHORT, isLive, fmtDate } from '../lib/ui/guide.ts';
// 새로 올라온 글: 공개된 가이드 중 최신 3편
const posts = (await getCollection('guide')).filter(isLive).sort((a, b) => b.data.publishAt.localeCompare(a.data.publishAt));
const latest = posts.slice(0, 3);
const sm = loadSummary();
const chgList = Object.entries(sm.sido).map(([sido, v]) => ({ sido, chg: v.chg })).filter((x) => x.chg);
const cap = sm.groups?.수도권?.chg ?? null;
const rCap = roneSido('수도권'), rAll = roneSido('전국');
const streakPill = (r: ReturnType<typeof roneSido>) => (r && Math.abs(r.streak) >= 2 ? `<span class="pill ${r.streak > 0 ? 'p-bad' : 'p-blue'}">최근 ${Math.abs(r.streak)}주째 ${r.streak > 0 ? '↑' : '↓'}</span>` : '');
const roneYoy = (r: ReturnType<typeof roneSido>) => (r && r.yoy != null ? `1년 ${r.yoy > 0 ? '+' : ''}${r.yoy.toFixed(1)}%` : '');
const cls = (y: number | null | undefined) => (y == null ? 'na' : y > 0 ? 'up' : y < 0 ? 'down' : '');

// 내 상황 5개 → 계산기 진입. 계산기는 1단계에서 채워진다.
const situations = [
  { key: 'first',   name: '생애최초',   desc: '첫 집 · LTV 우대 · 취득세 200만 감면', tone: 'b',
    icon: 'M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z' },
  { key: 'newly',   name: '신혼부부',   desc: '혼인 7년 이내 · 소득 기준 완화', tone: 'r',
    icon: 'M8.5 11.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4zM16 11.7a2.7 2.7 0 1 0 0-5.4 2.7 2.7 0 0 0 0 5.4zM2.5 20c0-3.6 2.7-6.2 6-6.2s6 2.6 6 6.2M15 14.3c2.9 0 5.5 2.3 5.5 5.7' },
  { key: 'youth',   name: '청년',       desc: '만 34세 이하 · 장래소득 인정', tone: 'g',
    icon: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21c0-4 3.6-7 8-7s8 3 8 7' },
  { key: 'general', name: '무주택 일반', desc: '디딤돌 · 보금자리론 · 주담대', tone: 's',
    icon: 'M5 3h14v18H5zM9 7h2M13 7h2M9 11h2M13 11h2M9 15h2M13 15h2M10 21v-3.5h4V21' },
  { key: 'move',    name: '갈아타기',   desc: '1주택 처분 · 일시적 2주택 세금 판정', tone: 'o',
    icon: 'M4 8h13l-3-3M20 16H7l3 3' },
];
---
<Base title="쏙집" hero>
  <section class="hero">
    <h1 class="big">내 예산에 <span class="blue">쏙</span> 들어오는 집,<br />쏙집이 추려드려요</h1>
    <p class="sub2">대출 자격 → 최대 예산 → 갈 수 있는 아파트 → 비교, 한 번에</p>
    <button type="button" class="searchbar" data-open-search>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="M20 20l-4-4" /></svg>
      <span>단지 이름으로 바로 찾기 <em>예: 까치마을, 수서동</em></span>
    </button>
  </section>

  <section class="card fold" data-fold="sit" data-fold-default="open" aria-labelledby="sit">
    <button type="button" class="fold-t" data-fold-t aria-expanded="true" aria-label="어떤 상황인가요 접기·펼치기"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg></button>
    <h2 id="sit" class="h">어떤 상황인가요?</h2>
    <div class="sgrid">
      {situations.map((s) => (
        <a class={`scell ${s.tone}`} href={`/calc/?s=${s.key}`} data-ev="home_situation" data-ev-label={s.key}>
          <span class="ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={s.icon} /></svg>
          </span>
          <b>{s.name}</b>
          <span class="d">{s.desc}</span>
          <span class="ch" aria-hidden="true">›</span>
        </a>
      ))}
    </div>
  </section>

  {chgList.length > 0 && (
    <section class="card chg fold" data-fold="chg" data-fold-default="closed" aria-labelledby="chg-h">
      <button type="button" class="fold-t" data-fold-t aria-expanded="true" aria-label="지역별 1년 변동률 접기·펼치기"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg></button>
      <h2 id="chg-h" class="h">지역별 1년 변동률 <span class="sub">실거래 {sm.asOf} 기준</span></h2>
      <div class="cgrid">
        {(cap || rAll) && (
          <a class="wide" href="/area/">
            <span class="half"><span class="nm">수도권 <span class="sub">서울·인천·경기</span></span><b class={cls(cap?.yoy)}><i>실거래</i>{cap?.yoy == null ? '표본 부족' : pct(cap.yoy)}</b>{rCap && <span class="rone"><span class="org">부동산원 </span><span class="short">지수</span><span class="long">매매가격지수:</span> {roneYoy(rCap)}</span>}{rCap && streakPill(rCap) && <span class="rone"><Fragment set:html={streakPill(rCap)} /></span>}</span>
            <span class="half"><span class="nm">전국 <span class="sub short">지수</span><span class="sub long">부동산원 매매가격지수</span></span><b class={cls(rAll?.yoy)}><i>지수 1년</i>{rAll && rAll.yoy != null ? `${rAll.yoy > 0 ? '+' : ''}${rAll.yoy.toFixed(1)}%` : '—'}</b><span class="rone"><Fragment set:html={streakPill(rAll)} /></span></span>
          </a>
        )}
        {chgList.map(({ sido, chg }) => { const r = roneSido(sido); return (
          <a class="ccell" href={`/area/#s-${sido}`}><span class="nm">{sido}</span><b class={cls(chg!.yoy)}><i>실거래</i>{chg!.yoy == null ? '표본 부족' : pct(chg!.yoy)}</b>{roneYoy(r) && <span class="rone"><span class="org">부동산원 </span>지수<span class="long">:</span> {roneYoy(r)}</span>}{streakPill(r) && <span class="rone"><Fragment set:html={streakPill(r)} /></span>}</a>
        ); })}
      </div>
      <p class="src"><b>실거래</b> = 쏙집이 국토부 실거래로 계산한 1년 변동률(평균이 아니라 같은 단지·같은 평형끼리 비교한 중앙값). <b>부동산원 지수</b> = 한국부동산원 주간 아파트 매매가격지수의 52주 전 대비(1년)와 전주 대비 연속 상승·하락 주 수(최근). 시·구 단위는 <a href="/area/">지역별 페이지</a>에서. 가격 전망이 아닙니다.</p>
    </section>
  )}

  <section class="card lncard fold" data-fold="line" data-fold-default="open" aria-labelledby="ln-h">
    <button type="button" class="fold-t" data-fold-t aria-expanded="true" aria-label="노선별 시세분석 접기·펼치기"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg></button>
    <a class="lnhead" href="/line/">
      <span class="lnic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="14" rx="3" /><path d="M5 11h14M9 21l-2-4M15 21l2-4" /><circle cx="9" cy="14" r=".6" fill="currentColor" /><circle cx="15" cy="14" r=".6" fill="currentColor" /></svg></span>
      <span class="lntx"><h2 id="ln-h" class="h">노선별 시세분석</h2><span class="d">지하철이 지나는 시·구를 순서대로, 84㎡ 시세와 10년 흐름</span></span>
    </a>
    <div class="lnchips">
      {LINES.map((l) => <a class="lnchip" href={`/line/${l.slug}/`} style={`--lc:${l.color}`} data-ev="home_line" data-ev-label={l.slug}><i></i>{l.name}</a>)}
    </div>
  </section>

  {latest.length > 0 && (
    <section class="card newg fold" data-fold="guide" data-fold-default="open" aria-labelledby="ng-h">
      <button type="button" class="fold-t" data-fold-t aria-expanded="true" aria-label="새로 올라온 글 접기·펼치기"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg></button>
      <h2 id="ng-h" class="h">새로 올라온 글 <span class="sub">공부 가이드</span></h2>
      <ul class="ngl">
        {latest.map((e) => (
          <li><a href={`/guide/${e.id}/`} data-ev="home_guide" data-ev-label={e.id}>
            <span class="meta"><span class="tag">{CAT_SHORT[e.data.category] ?? e.data.category}</span><span class="sub">{fmtDate(e.data.publishAt)}</span></span>
            <b>{e.data.title}</b>
          </a></li>
        ))}
      </ul>
      <a class="ngall" href="/guide/" data-ev="home_guide" data-ev-label="all">가이드 {posts.length}편 전체 보기 ›</a>
    </section>
  )}

  <section class="card quick fold" data-fold="quick" data-fold-default="open" aria-labelledby="qk">
    <button type="button" class="fold-t" data-fold-t aria-expanded="true" aria-label="예산을 이미 알고 있다면 접기·펼치기"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg></button>
    <h2 id="qk" class="h">예산을 이미 알고 있다면</h2>
    <div class="qgrid">
      <a class="qcell" href="/find/" data-ev="home_quick" data-ev-label="/find/"><b>집 찾기</b><span class="d">예산·지역·평형으로 지도에서</span></a>
      <a class="qcell" href="/area/" data-ev="home_quick" data-ev-label="/area/"><b>지역별 실거래</b><span class="d">대장 단지 · 거래 활발 · 1년 변동</span></a>
      <a class="qcell" href="/line/" data-ev="home_quick" data-ev-label="/line/"><b>노선별 시세분석</b><span class="d">지하철 따라 시·구 시세와 10년 흐름</span></a>
      <a class="qcell" href="/ref/" data-ev="home_quick" data-ev-label="/ref/"><b>공부 레퍼런스</b><span class="d">시도별 TOP · 정비사업 · 철도 호재 · 보도</span></a>
      <a class="qcell" href="/compare/" data-ev="home_quick" data-ev-label="/compare/"><b>단지 비교</b><span class="d">담아둔 단지 2~4개 나란히</span></a>
      <a class="qcell" href="/guide/" data-ev="home_quick" data-ev-label="/guide/"><b>공부 가이드</b><span class="d">대출·세금·시세 읽는 법, 숫자와 출처로</span></a>
    </div>
    <div class="chips">
      {[30000, 50000, 70000, 100000, 150000].map((a) => <a class="chip" href={`/budget/${a}/서울/`}>{a / 10000}억 서울</a>)}
    </div>
  </section>

  <script is:inline>
    // 홈 카드 접기: 처음 상태는 data-fold-default, 방문자가 바꾸면 이 브라우저에 기억
    (function () {
      var get = function (k) { try { return localStorage.getItem('fold:' + k); } catch (e) { return null; } };
      var set = function (k, v) { try { localStorage.setItem('fold:' + k, v); } catch (e) {} };
      document.querySelectorAll('[data-fold]').forEach(function (c) {
        var k = c.getAttribute('data-fold'), b = c.querySelector('[data-fold-t]');
        var apply = function (closed) { c.classList.toggle('closed', closed); b.setAttribute('aria-expanded', closed ? 'false' : 'true'); };
        apply((get(k) || c.getAttribute('data-fold-default')) === 'closed');
        b.addEventListener('click', function () { var closed = !c.classList.contains('closed'); apply(closed); set(k, closed ? 'closed' : 'open'); });
      });
    })();
  </script>
</Base>

<style>
  .hero { padding: 10px 4px 18px; }
  .hero h1 { margin: 0; }
  .hero p { margin: 8px 0 0; }
  .searchbar { display: flex; align-items: center; gap: 10px; width: 100%; margin: 16px 0 0; padding: 14px 16px; border: 0; border-radius: var(--radius-btn); background: var(--card); color: var(--muted); font: inherit; font-size: 15px; text-align: left; cursor: pointer; box-shadow: 0 1px 2px rgba(0,0,0,.03); }
  .searchbar span { flex: 1; min-width: 0; color: var(--fg2); font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .searchbar em { font-style: normal; color: var(--muted); font-weight: 500; margin-left: 6px; }
  .searchbar:hover { box-shadow: 0 2px 8px rgba(0,0,0,.06); }
  /* 상황 타일: 아래 "예산을 이미 알고 있다면"과 같은 격자. 폰에서는 한 줄에 하나, 480px부터 두 칸 */
  .sgrid { display: grid; grid-template-columns: 1fr; gap: 10px; margin-top: 10px; }
  .scell { position: relative; display: grid; grid-template-columns: 48px 1fr; grid-template-rows: auto auto; column-gap: 14px; row-gap: 2px; align-items: center; padding: 16px 40px 16px 16px; border-radius: 16px; color: inherit; background: var(--soft); }
  .scell .ic { grid-row: 1 / span 2; width: 48px; height: 48px; border-radius: 16px; background: var(--card); display: flex; align-items: center; justify-content: center; }
  .scell .ic svg { width: 24px; height: 24px; }
  .scell b { font-size: 17px; letter-spacing: -0.02em; line-height: 1.25; }
  .scell .d { font-size: 12.5px; color: var(--fg2); line-height: 1.4; }
  .scell .ch { position: absolute; right: 16px; top: 50%; transform: translateY(-50%); color: #b0b8c1; font-size: 22px; line-height: 1; }
  .scell.b { background: var(--blue-soft); } .scell.b .ic { color: var(--blue); }
  .scell.r { background: var(--red-soft); } .scell.r .ic { color: var(--red); }
  .scell.g { background: var(--green-soft); } .scell.g .ic { color: var(--green); }
  .scell.o { background: var(--orange-soft); } .scell.o .ic { color: var(--orange); }
  .scell.s { background: var(--soft); } .scell.s .ic { color: var(--fg2); }
  @media (min-width: 480px) {
    .sgrid { grid-template-columns: 1fr 1fr; }
    .scell:last-child { grid-column: 1 / -1; }
  }
  /* 카드 접기 */
  .fold { position: relative; }
  .fold > .h, .fold .lnhead { padding-right: 44px; }
  .fold-t { position: absolute; z-index: 2; top: calc(var(--pad) - 8px); right: calc(var(--pad) - 8px); width: 36px; height: 36px; border: 0; border-radius: 50%; background: var(--soft); color: var(--fg2); display: flex; align-items: center; justify-content: center; cursor: pointer; padding: 0; }
  .fold-t svg { width: 20px; height: 20px; transform: rotate(180deg); transition: transform .2s; }
  .fold.closed .fold-t svg { transform: none; }
  .fold.closed .sgrid, .fold.closed .ccell, .fold.closed > .src, .fold.closed .lnchips, .fold.closed .qgrid, .fold.closed .chips, .fold.closed .ngl, .fold.closed .ngall { display: none; }
  .newg { margin-top: var(--gap); }
  .ngl { list-style: none; margin: 4px 0 0; padding: 0; }
  .ngl li { border-bottom: 1px solid var(--soft); }
  .ngl a { display: flex; flex-direction: column; gap: 4px; padding: 12px 0; color: inherit; }
  .ngl .meta { display: flex; align-items: center; gap: 8px; }
  .ngl .tag { font-size: 11px; font-weight: 700; color: var(--blue); background: var(--blue-soft); padding: 2px 8px; border-radius: 999px; }
  .ngl .meta .sub { font-size: 12px; }
  .ngl b { font-size: 15px; line-height: 1.4; word-break: keep-all; }
  .ngall { display: block; padding: 12px 0 0; font-size: 13.5px; font-weight: 700; color: var(--blue); }
  .lncard { margin-top: var(--gap); }
  .lnhead { position: relative; display: flex; align-items: center; gap: 14px; color: inherit; }
  .lnic { flex: none; width: 48px; height: 48px; border-radius: 16px; background: var(--blue-soft); color: var(--blue); display: flex; align-items: center; justify-content: center; }
  .lnic svg { width: 24px; height: 24px; }
  .lntx { min-width: 0; display: flex; flex-direction: column; gap: 2px; } .lntx .h { margin: 0; } .lntx .d { font-size: 12.5px; color: var(--fg2); line-height: 1.4; word-break: keep-all; }
  .lnchips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
  .lnchip { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 700; padding: 7px 11px 7px 9px; border-radius: 999px; background: var(--soft); color: var(--fg); white-space: nowrap; }
  .lnchip i { width: 10px; height: 10px; border-radius: 50%; background: var(--lc); }
  .quick { margin-top: var(--gap); }
  .chg { margin-top: var(--gap); }
  .cgrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px; margin-top: 8px; }
  @media (min-width: 600px) { .cgrid { grid-template-columns: repeat(3, 1fr); } }
  .ccell { display: flex; flex-direction: column; gap: 1px; padding: 10px 12px; border-radius: 12px; background: var(--soft); color: inherit; }
  .ccell .nm { font-size: 13px; color: var(--fg2); font-weight: 600; }
  .ccell b { font-size: 19px; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .ccell b i, .cgrid .half b i { display: block; font-style: normal; font-size: 11px; font-weight: 600; color: var(--muted); letter-spacing: 0; line-height: 1.2; margin: 2px 0 0; white-space: nowrap; }
  .ccell, .cgrid .half { word-break: keep-all; overflow-wrap: anywhere; }
  .cgrid .long { display: none; } .cgrid .short { display: inline; } .cgrid .org { display: none; }
  @media (min-width: 375px) { .cgrid .org { display: inline; } }
  @media (min-width: 600px) { .cgrid .long { display: inline; } .cgrid .short { display: none !important; } }

  .ccell b.na { font-size: 13px; color: var(--muted); font-weight: 500; }
  .ccell .up { color: var(--red); } .ccell .down { color: var(--blue); }
  .ccell { min-width: 0; }
  .cgrid .wide { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; gap: 6px; color: inherit; }
  .cgrid .half { display: flex; flex-direction: column; gap: 1px; padding: 12px 14px; border-radius: 12px; background: var(--card); box-shadow: inset 0 0 0 1.5px var(--line); min-width: 0; }
  .cgrid .half .nm { font-size: 13px; color: var(--fg2); font-weight: 700; } .cgrid .half .nm .sub { font-weight: 500; }
  .cgrid .half b { font-size: 21px; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; } .cgrid .half b.na { font-size: 13px; color: var(--muted); font-weight: 500; }
  .cgrid .half .up { color: var(--red); } .cgrid .half .down { color: var(--blue); }
  .cgrid .rone .pill { font-size: 10.5px; padding: 2px 7px; }
  .cgrid .rone { font-size: 11px; color: var(--muted); font-weight: 500; line-height: 1.35; }
  .chg .src a { color: var(--blue); }
  .qgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px; }
  .qcell { display: flex; flex-direction: column; gap: 3px; padding: 12px 14px; border-radius: 14px; background: var(--soft); color: inherit; }
  .qcell b { font-size: 15px; } .qcell .d { font-size: 12px; color: var(--fg2); }
  .chips { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 10px; }
  .chip { font-size: 12.5px; font-weight: 600; padding: 7px 11px; border-radius: 999px; background: var(--blue-soft); color: var(--blue); }
</style>
