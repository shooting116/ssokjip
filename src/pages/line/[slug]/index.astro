---
import Base from '../../../layouts/Base.astro';
import { LINES, loadLine, MIN_COMPLEX } from '../../../lib/data/lines.ts';
import { eok, pct } from '../../../lib/ui/format.ts';

export function getStaticPaths() {
  return LINES.map((l) => ({ params: { slug: l.slug } }));
}
const d = loadLine(Astro.params.slug!)!;
const ref = d.ref;
const title = `${d.name} 시세분석 — 지나는 시·구별 84㎡ 시세와 흐름`;
const desc = `${d.name}이 지나는 ${d.regions.length}개 시·구를 노선 순서대로 놓고, 지역별 84㎡ 실거래 시세·1년 변동률과 부동산원 지수 10년 흐름을 ${ref.label}과 비교합니다. ${d.asOf} 기준.`;
const cls = (v: number | null) => (v == null ? 'na' : v > 0 ? 'up' : v < 0 ? 'down' : '');

// 그래프: 기준 지역 대비 상대지수(시작 주 = 100)
const PAL = ['#3182f6', '#f04452', '#00b493', '#f59e0b', '#8b5cf6', '#ec4899', '#0ea5e9', '#84cc16'];
const W = 340, H = 210, PL = 30, PR = 8, PT = 10, PB = 22;
const chart = d.chart;
const lines = chart ? chart.keys.map((k, i) => ({ r: d.regions.find((r) => r.lawd === k)!, c: PAL[i % PAL.length] })) : [];
const vals = lines.flatMap((l) => l.r.series!.filter((v): v is number => v != null));
const yMin = vals.length ? Math.floor(Math.min(95, ...vals) / 5) * 5 : 90, yMax = vals.length ? Math.ceil(Math.max(105, ...vals) / 5) * 5 : 110;
const n = chart?.periods.length ?? 0;
const X = (i: number) => PL + (i / Math.max(1, n - 1)) * (W - PL - PR);
const Y = (v: number) => PT + (1 - (v - yMin) / (yMax - yMin)) * (H - PT - PB);
const path = (s: (number | null)[]) => s.map((v, i) => (v == null ? '' : `${X(i).toFixed(1)},${Y(v).toFixed(1)}`)).filter(Boolean).join(' ');
const ticks: number[] = []; for (let v = yMin; v <= yMax; v += 5) ticks.push(v);
const lab = (p: string) => `${p.slice(0, 4)}`;
const xt: number[] = [];
if (chart) { let lastY = ''; chart.periods.forEach((p, i) => { const y = p.slice(0, 4); if (y !== lastY && Number(y) % 2 === 0 && i > 8 && i < n - 8) xt.push(i); lastY = y; }); }
const avgOf = (s: (number | null)[]) => { const v = s.filter((x): x is number => x != null); return v.length ? +(v.reduce((a, b) => a + b, 0) / v.length).toFixed(1) : null; };
const years = chart ? Math.round((n / 52) * 10) / 10 : 0;
const fromLabel = chart ? chart.labels[chart.periods[0]] ?? chart.periods[0] : '';
const toLabel = chart ? chart.labels[chart.periods[n - 1]] ?? chart.periods[n - 1] : '';
---
<Base title={title} description={desc}>
  <nav class="sub" style="padding:2px 4px 6px"><a href="/">홈</a> › <a href="/line/">노선별 시세분석</a> › {d.name}</nav>
  <header class="q" style="padding:4px 4px 10px">
    <h1 class="big" style="margin:0;font-size:24px;display:flex;align-items:center;gap:8px"><span class="ln" style={`background:${d.color}`}></span>{d.name} 시세분석</h1>
    <p class="sub2" style="margin:6px 0 0">{d.name}이 지나는 시·구 {d.regions.length}곳을 노선 순서대로 놓았습니다.</p>
    <p class="sub" style="margin:4px 0 0">기준: <b>{ref.label}</b> 84㎡ 시세 중앙값 <b>{eok(ref.med)}</b> = 100% (모든 노선 공통){!ref.onLine && ' · 이 노선은 서초구를 지나지 않습니다'}</p>
    {d.lineNote && <p class="sub" style="margin:2px 0 0">{d.lineNote} <a href="/guide/gtx-timeline-2026/">GTX 일정</a></p>}
    {d.note && <p class="sub" style="margin:2px 0 0">참고: {d.note.label} 84㎡ 시세 중앙값 <b>{eok(d.note.med)}</b> ({d.note.n}개 단지)</p>}
  </header>

  {chart && (
    <section class="card sec">
      <h2>{ref.label} 대비 흐름 <span class="sub">부동산원 지수 {years >= 9 ? '10년' : `${years}년`}, 시작 주 = 100</span></h2>
      <svg viewBox={`0 0 ${W} ${H}`} class="ch" role="img" aria-label={`${d.name} 지역별 ${ref.label} 대비 상대지수`}>
        {ticks.map((t) => <g><line x1={PL} x2={W - PR} y1={Y(t)} y2={Y(t)} class={t === 100 ? 'g100' : 'g'} /><text x={PL - 4} y={Y(t) + 3} class="yt">{t}</text></g>)}
        {xt.map((i) => <g><line x1={X(i)} x2={X(i)} y1={PT} y2={H - PB} class="g" /><text x={X(i)} y={H - 6} class="xt" text-anchor="middle">{lab(chart.periods[i])}</text></g>)}
        {lines.map((l) => { const a = avgOf(l.r.series!); return a != null ? <line x1={PL} x2={W - PR} y1={Y(a)} y2={Y(a)} stroke={l.c} stroke-width="1" stroke-dasharray="4 3" opacity=".55" /> : null; })}
        {lines.map((l) => <polyline points={path(l.r.series!)} fill="none" stroke={l.c} stroke-width="1.6" stroke-linejoin="round" />)}
      </svg>
      <table class="lgt"><thead><tr><th>지역</th><th>지금</th><th>{years >= 9 ? '10년 평균' : '기간 평균'}</th></tr></thead><tbody>{lines.map((l) => { const a = avgOf(l.r.series!); return <tr><td><span class="sw" style={`background:${l.c}`}></span>{l.r.label}</td><td><b>{l.r.series!.filter((v): v is number => v != null).at(-1)?.toFixed(1)}</b></td><td>{a != null ? a.toFixed(1) : '-'}</td></tr>; })}</tbody></table>
      <p class="src">{fromLabel} = 100으로 놓고, 각 지역 지수 변화를 {ref.label} 지수 변화로 나눈 값입니다(실선). 점선은 같은 기간 그 값의 평균입니다. 100보다 위면 시작 주보다 {ref.label}에 견줘 더 올랐다는 뜻이고, 가격 수준이나 앞으로의 방향을 뜻하지 않습니다. {toLabel}까지.</p>
    </section>
  )}

  <ol class="rl" style={`--lc:${d.color}`}>
    {d.regions.map((r, i) => (
      <li class:list={[{ ref: r.isRef }]}>
        <span class="dot" aria-hidden="true"></span>
        <a class="card rc" href={`/area/${r.lawd}/`}>
          <div class="hd">
            <span class="nm"><b>{r.label}</b>{r.isRef && <span class="pill p-soft">기준</span>}</span>
            <span class="pr">{r.med != null ? <b>{eok(r.med)}</b> : <span class="na">-</span>}</span>
          </div>
          <div class="st">{r.stations.join(' · ')}</div>
          <div class="kv">
            <span>{ref.label} 대비<b>{r.ratio != null ? `${r.ratio}%` : '-'}</b></span>
            <span>실거래 1년<b class={cls(r.yoy)}>{r.yoy != null ? pct(r.yoy) : '-'}</b></span>
            <span>지수 1년<b class={cls(r.rone)}>{r.rone != null ? pct(r.rone) : '-'}</b></span>
          </div>
        </a>
        {i === 3 && <div class="ad-slot" aria-hidden="true"></div>}
      </li>
    ))}
  </ol>

  <section class="card sec">
    <h2>숫자 읽는 법</h2>
    <ul class="how">
      <li><b>시세</b> = 그 시·구 전체 단지 중 84㎡ 타입(±5㎡) 최근 6개월 실거래가 3건 이상인 단지들의 중앙값(지역별 페이지와 같은 값). 단지가 {MIN_COMPLEX}곳 미만이면 비워 둡니다.</li>
      <li><b>{ref.label} 대비</b> = 이 지역 시세 ÷ {ref.label} 시세. 가격 수준을 비교한 계산값입니다.</li>
      <li><b>실거래 1년</b> = 최근 6개월 중앙값과 1년 전 같은 6개월 비교(평형별 변동률의 중앙값). <b>지수 1년</b> = 한국부동산원 주간 매매가격지수 52주 전 대비.</li>
      <li>역이 속한 시·구는 역 주소(GTX)나 역 반경 800m 안 단지가 가장 많은 시·구로 정했습니다. 구 경계에 있는 역은 실제 주소와 다를 수 있습니다.</li>
    </ul>
  </section>
  <p class="src">출처: 국토교통부 아파트 매매 실거래가({d.asOf} 기준, 해제·직거래 제외) · 한국부동산원 R-ONE 주간 아파트 매매가격지수 · 국가철도공단 전국도시철도역사정보.</p>
  <div class="ad-slot" aria-hidden="true"></div>
</Base>
<style>
  .ln { display: inline-block; width: 6px; height: 22px; border-radius: 3px; }
  .sec { margin-bottom: 12px; } .sec h2 { font-size: 16px; margin: 0 0 8px; } .sec h2 .sub { font-weight: 500; margin-left: 6px; }
  .ch { width: 100%; height: auto; display: block; }
  .ch .g { stroke: var(--soft, #eef0f3); stroke-width: 1; } .ch .g100 { stroke: #8b95a1; stroke-width: 1.2; stroke-dasharray: 3 3; }
  .ch .yt { font-size: 9px; fill: var(--muted, #8b95a1); text-anchor: end; } .ch .xt { font-size: 9px; fill: var(--muted, #8b95a1); }
  .lgt { width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 13px; font-variant-numeric: tabular-nums; }
  .lgt th { font-size: 11.5px; color: var(--muted); font-weight: 600; text-align: right; padding: 4px 0; } .lgt th:first-child { text-align: left; }
  .lgt td { padding: 4px 0; text-align: right; border-top: 1px solid var(--soft); } .lgt td:first-child { text-align: left; }
  .sw { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; vertical-align: -1px; }
  .rl { list-style: none; margin: 0 0 12px; padding: 0 0 0 18px; position: relative; }
  .rl::before { content: ''; position: absolute; left: 6px; top: 18px; bottom: 18px; width: 4px; border-radius: 2px; background: var(--lc); }
  .rl > li { position: relative; margin-bottom: 10px; }
  .dot { position: absolute; left: -17px; top: 18px; width: 14px; height: 14px; border-radius: 50%; background: #fff; border: 3px solid var(--lc); box-sizing: border-box; z-index: 1; }
  .ref .dot { background: var(--lc); }
  .rc { display: block; color: inherit; padding: 14px 16px; margin: 0; }
  .hd { display: flex; align-items: center; gap: 8px; }
  .nm { flex: 1; min-width: 0; display: flex; align-items: center; gap: 6px; } .nm b { font-size: 16px; }
  .nm .pill { font-size: 11px; padding: 2px 7px; }
  .pr b { font-size: 17px; font-variant-numeric: tabular-nums; }
  .st { font-size: 12.5px; color: var(--muted); margin: 3px 0 8px; word-break: keep-all; }
  .kv { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .kv span { display: flex; flex-direction: column; font-size: 11.5px; color: var(--muted); background: var(--bg, #f2f4f6); border-radius: 10px; padding: 7px 9px; }
  .kv b { font-size: 14px; color: var(--fg, #191f28); margin-top: 2px; font-variant-numeric: tabular-nums; }
  .up { color: var(--red) !important; } .down { color: var(--blue) !important; } .na { color: var(--muted); }
  .how { margin: 0; padding-left: 18px; font-size: 13.5px; line-height: 1.6; color: var(--fg2); } .how li { margin: 4px 0; }
  .ad-slot { min-height: 0; }
</style>
