---
import Base from '../../layouts/Base.astro';
import Ad from '../../components/Ad.astro';
import { loadSummary, type RegionChange } from '../../lib/data/index.ts';
import { pct } from '../../lib/ui/format.ts';
import { roneSido, roneSigungu, roneCity, roneAsOf, roneWeekHtml } from '../../lib/data/rone.ts';
const sm = loadSummary();
const rAsOf = roneAsOf();
const cap = sm.groups?.수도권?.chg ?? null;
const rCap = roneSido('수도권'), rAll = roneSido('전국');
// 연속 상승·하락 주 수 알약 (2주 이상일 때만)
const wkHtml = roneWeekHtml;
type Rn = Parameters<typeof roneWeekHtml>[0];
const wkStack = (r: Rn) => roneWeekHtml(r, 'stack');     // 작은 카드: 항상 두 줄
const wkHalf = (r: Rn) => roneWeekHtml(r, 'stack-sm');   // 수도권·전국 칸: 폰에서만 두 줄
const roneYoy = (r: ReturnType<typeof roneSido>) => (r && r.yoy != null ? `1년 ${r.yoy > 0 ? '+' : ''}${r.yoy.toFixed(1)}%` : '');
// 최근 3개월 = 부동산원 주간 지수의 13주 전 대비
type Rone = ReturnType<typeof roneSido>;
const sgn = (v: number) => `${v > 0 ? '+' : ''}${v.toFixed(1)}%`;
const m3Text = (r: Rone) => (r && r.m3 != null ? sgn(r.m3) : '—');
const m3Cls = (r: Rone) => (r && r.m3 != null ? (r.m3 > 0 ? 'up' : r.m3 < 0 ? 'down' : '') : 'na');
const y1Text = (r: Rone) => (r && r.yoy != null ? sgn(r.yoy) : '—');
const y1Cls = (r: Rone) => (r && r.yoy != null ? (r.yoy > 0 ? 'up' : r.yoy < 0 ? 'down' : '') : 'na');
const sidos = Object.keys(sm.sido);
const cities = sm.cities ?? {};
const byLawd = Object.fromEntries(sm.sigungu.map((g) => [g.lawd, g]));
// 1년 변동률 표기: 표본이 모자라면 비움
const yoyText = (c?: RegionChange | null) => (c && c.yoy != null ? pct(c.yoy) : '표본 부족');
const yoyCls = (c?: RegionChange | null) => (c && c.yoy != null ? (c.yoy > 0 ? 'up' : c.yoy < 0 ? 'down' : '') : 'na');
const volText = (c?: RegionChange | null) => (c && c.volPct != null ? `거래 ${c.cur.toLocaleString()}건 (1년 전 대비 ${c.volPct > 0 ? '+' : ''}${c.volPct}%)` : '');
---
<Base title="지역별 아파트 실거래" description={`수도권·광역시 ${sm.sigungu.length}개 시군구의 아파트 1년 변동률과 단지 ${sm.total.complexes.toLocaleString()}개의 실거래 시세. 국토교통부 ${sm.asOf} 기준.`}>
  <div class="q" style="padding:4px 4px 10px">
    <h1 class="big" style="margin:0;font-size:22px">지역별 실거래</h1>
    <p class="sub2" style="margin:4px 0 0">시도 전체와 시·구 단위의 1년 변동률과 최근 3개월 흐름. 시군구를 고르면 대장 단지·거래 활발 단지·전체 단지 목록을 볼 수 있어요.</p>
  </div>
  <Ad pos="top" />

  <section class="card" aria-labelledby="sido-h">
    <h2 id="sido-h">시도별 변동률 <span class="sub">1년 · 최근 3개월</span></h2>
    <div class="sgrid">
      {(cap || rAll) && (
        <div class="wide">
          <div class="half">
            <span class="nm">수도권 <span class="sub">서울·인천·경기</span></span>
            <span class="pr"><span class="k"><b>1년</b> 실거래</span><b class={`v ${yoyCls(cap)}`}>{yoyText(cap)}</b></span>
            <span class="pr"><span class="k"><b>3개월</b> 지수</span><b class={`v ${m3Cls(rCap)}`}>{m3Text(rCap)}</b></span>
            {wkHalf(rCap) && <Fragment set:html={wkHalf(rCap)} />}
            <span class="sub">{cap?.n ? `${cap.n.toLocaleString()}개 평형 비교` : ''}</span>
          </div>
          <div class="half">
            <span class="nm">전국 <span class="sub">부동산원 지수</span></span>
            <span class="pr"><span class="k"><b>1년</b> 지수</span><b class={`v ${y1Cls(rAll)}`}>{y1Text(rAll)}</b></span>
            <span class="pr"><span class="k"><b>3개월</b> 지수</span><b class={`v ${m3Cls(rAll)}`}>{m3Text(rAll)}</b></span>
            {wkHalf(rAll) && <Fragment set:html={wkHalf(rAll)} />}
            <span class="sub">실거래는 <span class="nw">수도권·광역시만</span></span>
          </div>
        </div>
      )}
      {sidos.map((sido) => { const c = sm.sido[sido].chg; const r = roneSido(sido); return (
        <a class="scell" href={`#s-${sido}`}>
          <span class="nm">{sido}</span>
          <span class="pr"><span class="k"><b>1년</b> 실거래</span><b class={`v ${yoyCls(c)}`}>{yoyText(c)}</b></span>
          <span class="pr"><span class="k"><b>3개월</b> 지수</span><b class={`v ${m3Cls(r)}`}>{m3Text(r)}</b></span>
          {wkStack(r) && <Fragment set:html={wkStack(r)} />}
          <span class="sub">{c?.n ? `${c.n.toLocaleString()}개 평형` : ''}{sido === '전남광주' ? ' · 옛 광주' : ''}</span>
        </a>
      ); })}
    </div>
    <p class="src"><b>1년 실거래</b> = 쏙집이 국토교통부 실거래({sm.asOf} 기준)로 계산한 1년 변동률. 평균이 아니라, 같은 단지·같은 평형의 최근 6개월 실거래 중앙값을 1년 전 같은 6개월과 비교한 변동률(두 기간 모두 3건 이상)의 <b>중앙값</b>입니다. 해제·직거래 제외, 비교 평형이 10개 미만이면 비웁니다. 6개월치 거래를 묶어 보기 때문에 최근 몇 달 사이 방향이 바뀌어도 늦게 반영됩니다.{rAsOf && <> <b>3개월 지수</b> = <b>한국부동산원 주간 아파트 매매가격지수</b>({rAsOf.label} 기준 주)의 13주 전 대비 변동률입니다. <b>전주 대비</b>는 같은 지수의 한 주 전 대비 변동률(0.01% 단위)이고, "N주 연속 상승·하락"은 그 변동률이 연속으로 +이거나 −인 주 수입니다. 방향이 이번 주에 바뀐 곳은 "상승 전환"·"하락 전환"으로 적습니다. 0.00%(보합)가 나오면 끊기며, 부동산원 주간 아파트가격동향과 같은 방식으로 셉니다. "부동산원 매매가격지수 1년"은 52주 전 대비입니다(출처: R-ONE 부동산통계). 1년 실거래와 3개월 지수는 출처와 계산 방식이 달라 서로 더하거나 빼는 값이 아닙니다.</>} 전남광주는 2026-07-01 출범한 전남광주통합특별시이며, 쏙집 실거래와 부동산원 지수 모두 옛 광주광역시 5개 구 기준입니다(전남 시·군은 미수집). 어느 쪽도 가격 전망이 아닙니다.</p>
  </section>

  <div class="sortbar">
    <span class="sub2">목록 정렬</span>
    <button type="button" class="chip on" data-sort="name">이름순</button>
    <button type="button" class="chip" data-sort="yoy">1년 높은 순</button>
    <button type="button" class="chip" data-sort="yoyAsc">1년 낮은 순</button>
  </div>

  {sidos.map((sido) => { const list = cities[sido] ?? []; const c = sm.sido[sido].chg; const rs = roneSido(sido); return (
    <section class="card" id={`s-${sido}`} style="margin-bottom:12px">
      <h2 class="sh">{sido} <span class="sub">1년 실거래</span> <b class={`yoy ${yoyCls(c)}`}>{yoyText(c)}</b>{rs?.m3 != null && <> <span class="sub">3개월 지수</span> <b class={`yoy ${m3Cls(rs)}`}>{m3Text(rs)}</b></>}</h2>
      <p class="sub" style="margin:0 0 6px">{sm.sido[sido].complexes.toLocaleString()}단지{c && volText(c) && ` · ${volText(c)} · 최근 6개월`}{roneYoy(rs) && ` · 부동산원 매매가격지수 ${roneYoy(rs)}`}{wkHtml(rs) && <Fragment set:html={wkHtml(rs)} />}</p>
      {list.every((x) => x.lawds.every((l) => (byLawd[l]?.complexes ?? 0) === 0)) ? <p class="sub2" style="margin:6px 0 0">실거래 수집 중입니다. 곧 열려요.</p> : (<>
        {list.some((x) => x.merged) && (
          <div class="grid one" data-list>
            {list.filter((x) => x.merged).map((x) => { const n = x.lawds.reduce((a, l) => a + (byLawd[l]?.complexes ?? 0), 0); const rc = roneCity(sido, x.name); return (
              <div class="cell merged" data-name={x.name} data-yoy={x.chg.yoy ?? ''}>
                <div class="row"><b>{x.name}</b><span class="yy">{x.chg.yoy != null && <i class="yl">1년 실거래</i>}<span class={`yoy ${yoyCls(x.chg)}`}>{yoyText(x.chg)}</span>{rc?.m3 != null && <><i class="yl">3개월 지수</i><span class={`yoy ${m3Cls(rc)}`}>{m3Text(rc)}</span></>}</span></div>
                <span class="sub">실거래 {n.toLocaleString()}단지 · {x.lawds.length}개 구{x.chg.n ? ` · ${x.chg.n}개 평형 비교` : ''}{roneYoy(rc) && ` · 부동산원 매매가격지수 ${roneYoy(rc)}`}{wkHtml(rc) && <Fragment set:html={wkHtml(rc)} />}</span>
                <div class="subs">{x.lawds.map((l) => { const g = byLawd[l]; return g && g.complexes > 0 ? <a href={`/area/${l}/`}>{g.sigungu.replace(`${x.name} `, '')}<i class={yoyCls(g.chg)}>{g.chg?.yoy != null ? pct(g.chg.yoy) : '—'}</i></a> : null; })}</div>
              </div>
            ); })}
          </div>
        )}
        <div class="grid" data-list>
          {list.filter((x) => !x.merged).map((x) => {
            const n = x.lawds.reduce((a, l) => a + (byLawd[l]?.complexes ?? 0), 0);
            const r = roneSigungu(sido, x.name);
            return n > 0 ? (
              <a class="cell" href={`/area/${x.lawds[0]}/`} data-name={x.name} data-yoy={x.chg.yoy ?? ''}>
                <b class="nm">{x.name}</b>
                <span class="pr"><span class="k"><b>1년</b> 실거래</span><b class={`v ${yoyCls(x.chg)}`}>{yoyText(x.chg)}</b></span>
                <span class="pr"><span class="k"><b>3개월</b> 지수</span><b class={`v ${m3Cls(r)}`}>{m3Text(r)}</b></span>
                {wkStack(r) && <Fragment set:html={wkStack(r)} />}
                <span class="sub">{n.toLocaleString()}단지{x.chg.n ? ` · ${x.chg.n}개 평형 비교` : ''}</span>
              </a>
            ) : <span class="cell off" data-name={x.name} data-yoy=""><b>{x.name}</b><span class="sub">수집 중</span></span>;
          })}
        </div>
      </>)}
    </section>
  ); })}
</Base>

<script>
  // 홈 카드 등에서 #s-서울 같은 앵커로 들어오면 글꼴 로딩 뒤 위치가 밀리므로 한 번 더 맞춘다
  if (location.hash) { const el = document.querySelector(decodeURIComponent(location.hash)); if (el) document.fonts.ready.then(() => el.scrollIntoView({ block: 'start' })); }
  // 목록 정렬: 이름순 / 변동률 순 (표본 부족은 맨 뒤)
  const bar = document.querySelector('.sortbar');
  bar?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-sort]'); if (!b) return;
    bar.querySelectorAll('.chip').forEach((x) => x.classList.toggle('on', x === b));
    const mode = b.dataset.sort;
    document.querySelectorAll<HTMLElement>('[data-list]').forEach((grid) => {
      const cells = Array.from(grid.children) as HTMLElement[];
      cells.sort((a, c) => {
        if (mode === 'name') return (a.dataset.name ?? '').localeCompare(c.dataset.name ?? '', 'ko');
        const ya = a.dataset.yoy === '' ? null : Number(a.dataset.yoy), yc = c.dataset.yoy === '' ? null : Number(c.dataset.yoy);
        if (ya == null && yc == null) return 0; if (ya == null) return 1; if (yc == null) return -1;
        return mode === 'yoy' ? yc - ya : ya - yc;
      });
      for (const el of cells) grid.appendChild(el);
    });
  });
</script>

<style>
  .card[id] { scroll-margin-top: 72px; } /* 시도 칸을 눌러 내려올 때 고정 머리말에 제목이 가리지 않게 */
  .card h2 { font-size: 16px; margin: 0 0 4px; } .card h2 .sub { font-weight: 500; margin-left: 4px; }
  .card h2.sh { margin: 0 0 2px; line-height: 1.5; } .card h2.sh .sub { margin-left: 6px; }
  .up { color: var(--red); } .down { color: var(--blue); } .na { color: var(--muted); font-weight: 500; }
  .sgrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px; margin-top: 8px; }
  @media (min-width: 600px) { .sgrid { grid-template-columns: repeat(3, 1fr); } }
  .scell { display: flex; flex-direction: column; gap: 1px; padding: 10px 12px; border-radius: 12px; background: var(--soft); color: inherit; }
  .scell .nm { font-size: 13px; color: var(--fg2); font-weight: 600; }
  /* 1년·3개월 두 줄: 왼쪽에 기간·출처, 오른쪽에 숫자. 두 숫자를 같은 크기로 */
  .pr { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0 6px; }
  .pr .k { font-size: 11.5px; color: var(--muted); font-weight: 500; white-space: nowrap; }
  .pr .k b { font-size: 12.5px; color: var(--fg2); font-weight: 700; }
  .pr .v { font-size: 16px; font-weight: 700; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .pr .v.na { font-size: 12px; font-weight: 500; letter-spacing: 0; }
  .scell .pr .v, .half .pr .v { font-size: 17px; } .scell .pr .v.na, .half .pr .v.na { font-size: 12px; }
  .scell .nm, .half .nm, .cell .nm { margin-bottom: 2px; }
  .scell :global(.wk), .half :global(.wk), .cell :global(.wk) { margin: 2px 0 1px; }
  .scell, .half, .cell { word-break: keep-all; overflow-wrap: anywhere; }
  .nw { white-space: nowrap; }
  .wide { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .half { display: flex; flex-direction: column; gap: 2px; padding: 12px 14px; border-radius: 12px; background: var(--card); box-shadow: inset 0 0 0 1.5px var(--line); min-width: 0; }
  .half .nm { font-size: 13px; color: var(--fg2); font-weight: 700; } .half .nm .sub { font-weight: 500; margin-left: 2px; }
  .scell, .cell { min-width: 0; }
  .sortbar { display: flex; align-items: center; gap: 6px; padding: 2px 4px 10px; overflow-x: auto; scrollbar-width: none; }
  .sortbar .chip { flex: none; font-size: 12.5px; font-weight: 600; padding: 7px 11px; border-radius: 999px; background: var(--card); color: var(--fg2); border: 0; cursor: pointer; white-space: nowrap; }
  .sortbar .chip.on { background: var(--fg); color: #fff; }
  .yoy { font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .yy { display: inline-flex; flex-wrap: wrap; justify-content: flex-end; align-items: baseline; gap: 0 4px; }
  .yy .yl { font-style: normal; font-size: 11px; font-weight: 600; color: var(--muted); } .yy .yoy + .yl { margin-left: 6px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 6px; margin-top: 8px; }
  .cell { display: flex; flex-direction: column; gap: 2px; padding: 10px 12px; border-radius: 12px; background: var(--soft); color: inherit; font-size: 14px; min-width: 0; }
  .cell .row { display: flex; justify-content: space-between; align-items: baseline; gap: 6px; }
  .cell .row > b, .cell > b.nm { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cell.off { opacity: .5; }
  .grid.one { grid-template-columns: 1fr; margin-bottom: 6px; }
  .subs { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px; }
  .subs a { display: inline-flex; align-items: center; gap: 4px; font-size: 12.5px; font-weight: 600; color: var(--fg); background: var(--card); padding: 5px 9px; border-radius: 999px; }
  .subs a i { font-style: normal; font-weight: 700; font-variant-numeric: tabular-nums; }
  .subs a i.na { color: var(--muted); font-weight: 500; }
</style>
