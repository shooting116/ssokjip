---
import Base from '../../../layouts/Base.astro';
import { loadSummary, loadSigungu, type Complex } from '../../../lib/data/index.ts';
import { eok, pct } from '../../../lib/ui/format.ts';
import { roneSigungu, roneCity, roneSido, roneText } from '../../../lib/data/rone.ts';
import { linesOfLawd } from '../../../lib/data/lines.ts';

export function getStaticPaths() {
  return loadSummary().sigungu.filter((g) => g.complexes > 0).map((g) => ({ params: { lawd: g.lawd } }));
}
const { lawd } = Astro.params;
const sg = loadSigungu(lawd!)!;
const cs = sg.complexes;
// 1년 변동률: 이 시군구 · (구가 속한 시) · 시도 전체
const sm = loadSummary();
const meta = sm.sigungu.find((g) => g.lawd === lawd);
const chg = meta?.chg ?? null;
const city = (sm.cities?.[sg.sido] ?? []).find((x) => x.merged && x.lawds.includes(lawd!)) ?? null;
const sidoChg = sm.sido[sg.sido]?.chg ?? null;
const yoyText = (c: { yoy: number | null } | null | undefined) => (c && c.yoy != null ? pct(c.yoy) : '표본 부족');
const yoyCls = (c: { yoy: number | null } | null | undefined) => (c && c.yoy != null ? (c.yoy > 0 ? 'up' : c.yoy < 0 ? 'down' : '') : 'na');
const rone = roneSigungu(sg.sido, sg.sigungu);
const roneLine = [rone && roneText(rone) ? `${sg.sigungu} ${roneText(rone)}` : '', city && roneText(roneCity(sg.sido, city.name)) ? `${city.name} ${roneText(roneCity(sg.sido, city.name))}` : '', roneText(roneSido(sg.sido)) ? `${sg.sido} 전체 ${roneText(roneSido(sg.sido))}` : ''].filter(Boolean).join(' · ');
const repOf = (c: Complex) => c.types.find((t) => t.key === c.rep);
const trades36 = cs.reduce((a, c) => a + c.n36, 0);
const trades6 = cs.reduce((a, c) => a + c.n6, 0);

// 대장: 84㎡(±5) 타입 시세 기준, 6개월 3건 이상
const by84 = cs.map((c) => ({ c, t: c.types.find((t) => Math.abs(t.key - 84) <= 5 && t.basis === 'median6') })).filter((x) => x.t).sort((a, b) => b.t!.price! - a.t!.price!).slice(0, 10);
// 거래 활발: 최근 6개월 거래 건수
const active = [...cs].sort((a, b) => b.n6 - a.n6 || b.n12 - a.n12).slice(0, 10);
const nHot = cs.filter((c) => c.hot).length;
// 1년 변동: 대표 평형, 6개월 중앙값 기준(현재·1년 전 모두 3건 이상)
const yoyList = cs.map((c) => ({ c, t: repOf(c) })).filter((x) => x.t && x.t.yoy != null && x.t.basis === 'median6');
const up = [...yoyList].sort((a, b) => b.t!.yoy! - a.t!.yoy!).slice(0, 10);
const down = [...yoyList].sort((a, b) => a.t!.yoy! - b.t!.yoy!).filter((x) => x.t!.yoy! < 0).slice(0, 10);
// 평형별 시세 분포 (84㎡ 기준 중앙값)
const p84 = by84.length ? cs.map((c) => c.types.find((t) => Math.abs(t.key - 84) <= 5 && t.price && t.basis === 'median6')?.price).filter((v): v is number => !!v).sort((a, b) => a - b) : [];
const med84 = p84.length ? p84[p84.length >> 1] : null;

const lines = linesOfLawd(lawd!);   // 이 시·구를 지나는 수도권 노선(없으면 카드 생략)

const title = `${sg.sido} ${sg.sigungu} 아파트 실거래가·시세`;
const desc = `${sg.sigungu} 아파트 ${cs.length.toLocaleString()}개 단지의 실거래 시세. 대장 단지·거래 활발 단지·1년 변동. 국토교통부 실거래가 ${sg.asOf} 기준.`;
---
<Base title={title} description={desc}>
  <nav class="sub" style="padding:2px 4px 6px"><a href="/">홈</a> › <a href="/area/">지역별</a> › {sg.sido}</nav>
  <header class="q" style="padding:4px 4px 10px">
    <h1 class="big" style="margin:0;font-size:24px">{sg.sido} {sg.sigungu}</h1>
    <p class="sub2" style="margin:6px 0 0">단지 {cs.length.toLocaleString()}개 · 36개월 거래 {trades36.toLocaleString()}건 · 최근 6개월 {trades6.toLocaleString()}건{sg.regulated ? ' · 규제지역' : ''}</p>
    {med84 && <p class="sub2" style="margin:4px 0 0">84㎡ 타입 시세 중앙값 <b>{eok(med84)}</b> <span class="sub">(6개월 거래 3건 이상 {p84.length}개 단지)</span></p>}
    {chg && <p class="sub2 chgline" style="margin:6px 0 0">실거래 1년 변동률 <b class={yoyCls(chg)}>{yoyText(chg)}</b>{chg.n ? <span class="sub"> ({chg.n}개 평형 비교)</span> : null}{city && <> · {city.name} <b class={yoyCls(city.chg)}>{yoyText(city.chg)}</b></>}{sidoChg && <> · {sg.sido} 전체 <b class={yoyCls(sidoChg)}>{yoyText(sidoChg)}</b></>}{chg.volPct != null && <span class="sub"> · 최근 6개월 거래 {chg.cur.toLocaleString()}건, 1년 전보다 {chg.volPct > 0 ? '+' : ''}{chg.volPct}%</span>}</p>}
    {roneLine && <p class="sub" style="margin:4px 0 0">부동산원 매매가격지수(한국부동산원 주간{rone ? `, ${rone.asOfLabel} 기준 주` : ''}): {roneLine}</p>}
  </header>
  <a class="btn" href={`/find/?lawd=${lawd}`} style="margin-bottom:12px">내 예산으로 {sg.sigungu} 단지 찾기</a>

  {lines.length > 0 && (
    <section class="card sec">
      <h2>이 지역을 지나는 노선 <span class="sub">{lines.length}개</span></h2>
      <ul class="lnl">{lines.map((l) => (
        <li><a href={`/line/${l.slug}/`} data-ev="area_line" data-ev-label={l.slug}>
          <i style={`background:${l.color}`}></i><b>{l.name}</b><span class="st">{l.stations.join(' · ')}</span><span class="ch" aria-hidden="true">›</span>
        </a></li>
      ))}</ul>
      <p class="src">노선을 누르면 그 노선이 지나는 시·구의 84㎡ 시세와 10년 지수 흐름을 노선 순서대로 봅니다. 역 자료: 국가철도공단 전국도시철도역사정보(역이 속한 시·구는 역 주소 기준), GTX는 쏙집 철도 규칙표.</p>
    </section>
  )}
  {by84.length > 0 && (
    <section class="card sec">
      <h2>84㎡ 기준 시세 상위 <span class="sub">6개월 중앙값</span></h2>
      <ol class="rank">{by84.map(({ c, t }) => <li><a href={`/apt/${c.id}/`}><span class="nm">{c.name} <span class="sub">{c.umd}{c.built ? ` · ${c.built}년` : ''}</span></span><b>{eok(t!.price)}</b></a></li>)}</ol>
      <p class="src">같은 타입(84㎡ ±5)의 최근 6개월 실거래 중앙값. 순위는 가격일 뿐 가치 판단이 아닙니다.</p>
    </section>
  )}
  <section class="card sec">
    <h2>최근 6개월 거래 많은 단지</h2>
    <ol class="rank">{active.map((c) => <li><a href={`/apt/${c.id}/`}><span class="nm">{c.name}{c.hot && <span class="pill p-hot hp">🔥 거래 활발</span>} <span class="sub">{c.umd} · {c.rep}㎡ {eok(c.price)}</span></span><b>{c.n6}건</b></a></li>)}</ol>
    {nHot > 0 && <p class="src">🔥 거래 활발 = 최근 6개월 거래 ÷ 세대수(회전율)가 {sg.sigungu} 안에서 상위 10%인 단지 {nHot}개 (6개월 5건 이상만 비교, 세대수 미확인 단지는 건수로 따로 비교). 건수 순위와 다를 수 있고, 가격 전망이 아닙니다.</p>}
  </section>
  <div class="ad-slot" aria-hidden="true"></div>
  {up.length > 0 && (
    <section class="card sec">
      <h2>1년 상승 상위 <span class="sub">대표 평형 6개월 중앙값 비교</span></h2>
      <ol class="rank">{up.map(({ c, t }) => <li><a href={`/apt/${c.id}/`}><span class="nm">{c.name} <span class="sub">{c.umd} · {t!.label} {eok(t!.price)}</span></span><b class="up">{pct(t!.yoy)}</b></a></li>)}</ol>
    </section>
  )}
  {down.length > 0 && (
    <section class="card sec">
      <h2>1년 하락 상위</h2>
      <ol class="rank">{down.map(({ c, t }) => (
        <li>
          <a href={`/apt/${c.id}/`}><span class="nm">{c.name} <span class="sub">{c.umd} · {t!.label} {eok(t!.price)}</span></span><b class="down">{pct(t!.yoy)}</b></a>
          {c.news.length > 0 && <ul class="nl">{c.news.slice(0, 2).map((n) => <li><a href={n.u} rel="noopener nofollow" target="_blank">{n.t}</a> <span class="sub">{n.o} · {n.d}</span></li>)}</ul>}
        </li>
      ))}</ol>
      <p class="src">상승·하락은 현재 6개월 중앙값과 1년 전 같은 기간 중앙값의 차이입니다. 양쪽 모두 3건 이상인 단지만 집계했고, 층·동·거래 사정에 따라 실제 체감과 다를 수 있습니다.</p>
    </section>
  )}
  <section class="card sec">
    <h2>전체 단지 <span class="sub">{cs.length.toLocaleString()}개 · 거래 많은 순</span></h2>
    <ul class="all">{cs.map((c) => <li><a href={`/apt/${c.id}/`}>{c.name}<span class="sub"> {c.umd}{c.built ? ` · ${c.built}` : ''} · {c.rep ?? '-'}㎡ {eok(c.price)}{c.static ? '' : ' · 거래 적음'}</span></a></li>)}</ul>
  </section>
  <p class="src">출처: 국토교통부 아파트 매매 실거래가 ({sg.asOf} 기준) · K-apt. 시세는 최근 6개월 실거래 중앙값(해제·직거래 제외).</p>
</Base>
<style>
  .chgline .na { color: var(--muted); font-weight: 500; }
  .sec { margin-bottom: 12px; }
  .sec h2 { font-size: 16px; margin: 0 0 6px; } .sec h2 .sub { font-weight: 500; margin-left: 6px; }
  .rank { list-style: none; margin: 0; padding: 0; counter-reset: r; }
  .rank > li { counter-increment: r; border-bottom: 1px solid var(--soft); }
  .rank > li:last-child { border-bottom: 0; }
  .rank > li > a { display: flex; align-items: center; gap: 10px; padding: 11px 0; color: inherit; }
  .rank > li > a::before { content: counter(r); width: 22px; flex: none; color: var(--muted); font-weight: 700; font-variant-numeric: tabular-nums; }
  .nl { list-style: none; margin: 0 0 8px 32px; padding: 0; font-size: 12.5px; }
  .nl li { margin: 2px 0; } .nl a { color: var(--fg2); }
  .rank .nm { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600; }
  .rank b { flex: none; font-variant-numeric: tabular-nums; }
  .rank .hp { font-size: 10.5px; padding: 2px 7px; margin-left: 4px; vertical-align: 1px; }
  .up { color: var(--red); } .down { color: var(--blue); }
  .all { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: 16px; font-size: 13.5px; }
  .all li { break-inside: avoid; padding: 5px 0; }
  .all a { color: inherit; font-weight: 600; }
  .ad-slot { min-height: 0; margin-bottom: 12px; }
  .lnl { list-style: none; margin: 0; padding: 0; }
  .lnl li { border-bottom: 1px solid var(--soft); } .lnl li:last-child { border-bottom: 0; }
  .lnl a { display: flex; align-items: center; gap: 10px; padding: 11px 0; color: inherit; }
  .lnl i { flex: none; width: 10px; height: 10px; border-radius: 50%; }
  .lnl b { flex: none; min-width: 76px; font-size: 14.5px; white-space: nowrap; }
  .lnl .st { flex: 1; min-width: 0; font-size: 12.5px; color: var(--fg2); line-height: 1.45; word-break: keep-all; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; }
  .lnl .ch { flex: none; color: #b0b8c1; font-size: 20px; line-height: 1; }
</style>
