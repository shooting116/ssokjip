---
// 수동 광고 단위 한 칸.
//  - pos: result(결과 아래) · mid(목록·본문 중간) · bottom(하단) → 애드센스가 준 반응형 코드 그대로(폰에서는 화면 폭)
//  - pos: top(제목 바로 아래) → 높이를 고정한 얇은 띠(폰 100px · PC 90px). 첫 화면에서 내용이 광고에 밀리지 않게 한다.
// 여백·'광고' 표시·숨김 규칙은 global.css의 .ad-slot.
// lib/ads.ts의 MANUAL_ADS가 false이면 광고 단위를 넣지 않는다: 상단은 아무것도 그리지 않고, 나머지는 예전처럼 빈 자리만 남긴다.
import { AD_CLIENT, AD_SLOTS, AD_TOP_SLOT, MANUAL_ADS, type AdPos } from '../lib/ads';
interface Props { pos: AdPos | 'top' }
const { pos } = Astro.props;
---
{!MANUAL_ADS ? (
  pos === 'top' ? null : <div class="ad-slot" aria-hidden="true"></div>
) : pos === 'top' ? (
  <div class="ad-slot" data-ad="top">
    {/* 크기 고정은 애드센스 도움말의 방식: 반응형 속성(data-ad-format · data-full-width-responsive)을 빼고, 페이지 안의 <style>로 크기를 준다(외부 스타일시트는 공식 지원이 아님). */}
    <style is:inline>.ssok_top{width:100%;height:100px}@media(min-width:640px){.ssok_top{height:90px}}</style>
    <ins class="adsbygoogle ssok_top" style="display:block" data-ad-client={AD_CLIENT} data-ad-slot={AD_TOP_SLOT}></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
) : (
  <div class="ad-slot" data-ad={pos}>
    <ins class="adsbygoogle" style="display:block" data-ad-client={AD_CLIENT} data-ad-slot={AD_SLOTS[pos]} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}
